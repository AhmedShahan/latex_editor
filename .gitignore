# ============================================================
# Dependencies
# ============================================================
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ============================================================
# Build output
# ============================================================
dist/
dist-ssr/
build/
out/
.output/
*.tsbuildinfo

# ============================================================
# Environment variables & secrets
# NOTE: Vite inlines anything prefixed with VITE_ into the client
# bundle at build time, so these must NEVER be committed.
# ============================================================
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# ============================================================
# Package-manager auth files (may contain _authToken)
# ============================================================
.npmrc
.yarnrc

# ============================================================
# Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Tool caches / test output
# ============================================================
.cache/
.vite/
.eslintcache
.oxlintcache
.parcel-cache/
.turbo/
.npm/
coverage/
.nyc_output/
*.lcov

# ============================================================
# Editor directories and files
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.zed/
.history/
*.code-workspace
*.sw?
*.swo
*.swn
*~
.project
.settings/
.classpath
.c9/
*.launch

# ============================================================
# OS generated files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ============================================================
# Local overrides & deploy scratch dirs
# ============================================================
*.local
.vercel/
.netlify/
.vite-inspect/

# ============================================================
# Vite
# ============================================================
vite.config.ts.timestamp-*